{
  "name": "workout",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "packageManager": "bun@1.3.2",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.ts *.mts *.json",
    "format": "prettier --write src tests *.ts *.mts *.json",
    "check": "bun run format:check && bun run typecheck && bun run test",
    "export:ios": "expo export --platform ios"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.15",
    "effect": "4.0.0-rc.112",
    "expo": "57.0.20",
    "expo-sqlite": "57.0.2",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0-rc.112",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.4",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "vitest": "4.1.0"
  }
}
